---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import SocialPill from "../icons/SocialPill.astro";
import GitHub from "../icons/Github.astro";
import Mail from "../icons/Mail.astro";
import Experience from "../components/Experience.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Briefcase from "../icons/Briefcase.astro";
import CodeIcon from "../icons/Code.astro";
import Projects from "../components/Projects.astro";
---

<Layout 
title="Portfolio de Ángel David Escobar Ibañez - Fullstack Developer"
description="Soy Ángel David Escobar Ibañez, un desarrollador web con más de 2 años de experiencia en desarrollo Fullstack. Utilizo tecnologías como React, Next.js, Astro y Node.js para crear aplicaciones web modernas y eficientes.">

	<main>
		<SectionContainer  class="py-44 pb-24">
			<h1
				class="text-white text-5xl font-bold flex flex-row gap-x-4 pb-10"
			>
				Hola, Soy Ángel <a
					href="https://www.linkedin.com/in/angel-david-escobar-iba%C3%B1ez-77045b277/"
					target="_blank"
					rel="noopener"
					class="flex justify-center items-center"
					><Badge>Disponible para trabajar</Badge></a
				>
			</h1>
			<h2 class="text-xl text-wrap">
				+1 año de experiencia en desarrollo web, especializado en
				frontend y con conocimientos en backend y diseño UI/UX.
				utilizando tecnologías como <span class="text-[#a3d9a5]"
					>React</span
				>, <span class="text-[#a3d9a5]">Next.js</span>, <span
					class="text-[#a3d9a5]">Astro</span
				> y <span class="text-[#a3d9a5]">Node.js</span>.
			</h2>

			<nav class="flex flex-row gap-x-2 mt-10">
				<SocialPill href="https://www.linkedin.com/in/angel-david-escobar-iba%C3%B1ez-77045b277/" >
					<LinkedIn class="size-6" />
					LinkedIn
				</SocialPill>
				<SocialPill href="https://github.com/AngelDavidEscobar">
					<GitHub class="size-6" />
					Github
				</SocialPill>
				<SocialPill href="mailto:angelescobar512@gmail.com">
					<Mail class="size-6" />
					angelescobar512@gmail.com
				</SocialPill>
				
			</nav>
		</SectionContainer>

		<SectionContainer id ="experiencia" >
			<h2 class="text-3xl text-white font-bold pb-10 flex gap-x-3 items-center">
				<Briefcase class="size-7 me-2" />
				Experiencia
			</h2>
			<ul class="relative border-l border-neutral-secondary-medium">
				<Experience />
			</ul>
		</SectionContainer>

		<SectionContainer id ="proyectos" >
			<h2 class="text-3xl text-white font-bold pb-10 flex gap-x-3 items-center">
				<CodeIcon class="size-7 me-2" />
				Proyectos
			</h2>
			<ul class="relative border-l border-neutral-secondary-medium">
				<Projects />
			</ul>
		</SectionContainer>
	</main>
</Layout>
