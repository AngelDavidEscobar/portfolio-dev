---
const PROJECTS = [
    {
        
        title: "Portafolio Personal",
        description:
            "Desarrollé un portafolio personal utilizando Astro, Tailwind CSS y TypeScript. Este proyecto me permitió mostrar mis habilidades en desarrollo web y diseño de interfaces, así como implementar buenas prácticas de desarrollo y optimización del rendimiento.",
        link: "https://angelescobar512.github.io/portafolio-personal/",
        githubLink: "https://github.com/tu-usuario/portafolio-personal",
        image: "/images/portafolio-personal.png",
        tags: ["Astro", "Tailwind CSS", "TypeScript"],
    },
    
];
---

{
    PROJECTS.map((project) => (
        <li class="mb-8 ml-4">
            <div class="absolute w-3 h-3 bg-[#a3d9a5] rounded-full mt-1.5 -left-1.5 border border-white/10"></div>
            <time class="mb-1 text-sm font-normal leading-none text-neutral-secondary-medium">
                {project.title}
            </time>
            <h3 class="text-lg font-semibold text-white">{project.title}</h3>
            <p class="mb-4 text-base font-normal text-neutral-secondary-medium">
                {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
                {project.tags.map((tag) => (
                    <span
                        class="bg-[#a3d9a5]/10 text-[#a3d9a5] px-2 py-1 rounded-full text-sm"
                    >
                        {tag}
                    </span>
                ))}
            </div>
            <div class="flex gap-x-4">
                <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#a3d9a5] hover:underline"
                >
                    Ver proyecto
                </a>
                <a
                    href={project.githubLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#a3d9a5] hover:underline"
                >
                    Código fuente
                </a>
            </div>
        </li>
    ))
}