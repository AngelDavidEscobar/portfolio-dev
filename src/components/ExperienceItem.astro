---
const {title, description, date, link} = Astro.props;
---



<div class="absolute w-3 h-3 bg-accent rounded-full mt-1.5 -start-1.5 border border-bg"></div>
                <time class="font-mono text-sm leading-none text-fg-subtle">{date}</time>
                <h3 class="text-lg font-semibold text-accent my-2">{title}</h3>
                <p class="mb-4 text-base text-fg-muted text-pretty leading-relaxed">{description}</p>
                {
                    link && (
                        <a href={link} class="inline-flex items-center text-fg border border-border hover:bg-white/10 transition-colors font-medium leading-5 rounded-lg text-sm px-4 py-2.5">
                            
                            Ver más
                            <svg class="w-4 h-4 ms-1.5 -me-0.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5m14 0-4 4m4-4-4-4"/></svg>
                        </a>
                    )
                }
               