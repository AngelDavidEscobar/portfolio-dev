---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { Project } from "../../src/types/project";
import TechTag from "./TechTag.astro";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<article class="project-item group grid items-center gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
    <a
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        tabindex="-1"
        aria-hidden="true"
        class="block overflow-hidden rounded-2xl ring-1 ring-white/10"
    >
        <Image
            src={project.image}
            alt={project.imageAlt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 45vw, 100vw"
            class="aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
        />
    </a>

    <div class="flex flex-col gap-3">
        <h3 class="text-lg font-semibold text-white">{project.title}</h3>
        <p class="max-w-[65ch] text-sm leading-relaxed text-white/70">
            {project.description}
        </p>
        <ul class="flex flex-wrap gap-2" aria-label="Tecnologías utilizadas">
            {project.tech.map((key) => <TechTag tech={key} />)}
        </ul>
        <div class="mt-1 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
            <a
                href={project.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-medium text-accent transition-opacity hover:opacity-80 active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
                Ver proyecto
                <Icon name="ph:arrow-up-right" class="size-4" aria-hidden="true" />
            </a>
            {project.repoUrl && (
                <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-white/70 transition-colors hover:text-accent active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                >
                    Código fuente
                </a>
            )}
        </div>
    </div>
</article>

<style>
    .project-item[data-reveal] {
        opacity: 0;
        transform: translateY(24px);
        transition:
            opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
            transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .project-item[data-reveal].is-visible {
        opacity: 1;
        transform: none;
    }
</style>