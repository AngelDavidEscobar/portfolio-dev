---
import { EXPERIENCE } from "../data/experience";
import ExperienceItem from "./ExperienceItem.astro";
---

<ol class="relative border-s border-border">
    {
        EXPERIENCE.map((item) => (
            <li class="relative mb-12 ms-6 last:mb-0">
                <ExperienceItem experience={item} />
            </li>
        ))
    }
</ol>
