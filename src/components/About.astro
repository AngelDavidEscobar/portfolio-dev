---
import { Icon } from "astro-icon/components";
import { CERTIFICATIONS, EDUCATION, LANGUAGES, SKILL_GROUPS } from "../data/about";
import TechTag from "./TechTag.astro";
---

<div class="flex flex-col gap-4 leading-relaxed text-pretty text-fg-muted">
    <p>
        Me gusta construir productos de <span class="text-fg">extremo a extremo</span>: desde la
        arquitectura y el diseño hasta el despliegue y la operación. He diseñado APIs RESTful e
        integraciones seguras con cifrado y autenticación, y despliego en AWS y servidores Linux y
        Windows.
    </p>
    <p>
        Trabajo con autonomía tomando decisiones técnicas y de producto, y uso herramientas de
        desarrollo asistido por IA para entregar más rápido sin sacrificar calidad. Me motiva aprender
        y aportar a productos con impacto real en las personas.
    </p>
</div>

<dl class="mt-10 grid gap-6 sm:grid-cols-2">
    {SKILL_GROUPS.map(({ title, tech }) => (
        <div>
            <dt class="font-mono text-sm text-fg-subtle">{title}</dt>
            <dd class="mt-3">
                <ul class="flex flex-wrap gap-2" aria-label={`Tecnologías de ${title}`}>
                    {tech.map((key) => <TechTag tech={key} />)}
                </ul>
            </dd>
        </div>
    ))}
</dl>

<div class="mt-10 grid gap-4 sm:grid-cols-2">
    <div class="rounded-2xl border border-border bg-surface/60 p-5">
        <h3 class="flex items-center gap-2 font-mono text-sm text-fg-subtle">
            <Icon name="ph:graduation-cap" class="size-4" aria-hidden="true" />
            Formación
        </h3>
        <p class="mt-3 font-semibold text-fg">{EDUCATION.degree}</p>
        <p class="text-fg-muted">{EDUCATION.school}</p>
        <p class="mt-1 font-mono text-sm text-fg-subtle">{EDUCATION.date}</p>
    </div>

    <div class="rounded-2xl border border-border bg-surface/60 p-5">
        <h3 class="flex items-center gap-2 font-mono text-sm text-fg-subtle">
            <Icon name="ph:translate" class="size-4" aria-hidden="true" />
            Idiomas
        </h3>
        <ul class="mt-3 flex flex-col gap-1">
            {LANGUAGES.map(({ name, level }) => (
                <li class="flex justify-between gap-4">
                    <span class="text-fg">{name}</span>
                    <span class="font-mono text-sm text-accent">{level}</span>
                </li>
            ))}
        </ul>
    </div>

    <div class="rounded-2xl border border-border bg-surface/60 p-5 sm:col-span-2">
        <h3 class="flex items-center gap-2 font-mono text-sm text-fg-subtle">
            <Icon name="ph:certificate" class="size-4" aria-hidden="true" />
            Cursos — {CERTIFICATIONS.issuer}
        </h3>
        <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-fg-muted">
            {CERTIFICATIONS.courses.map((course, i) => (
                <li>
                    {course}
                    {i < CERTIFICATIONS.courses.length - 1 && <span class="ms-3 text-fg-subtle" aria-hidden="true">·</span>}
                </li>
            ))}
        </ul>
    </div>
</div>
